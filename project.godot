; Engine configuration file.
; Godot 4.4 project for DARK PARK.

config_version=5

[application]

config/name="Dark Park"
config/description="Night shift at a car park security booth, 1989."
config/version="0.8.6"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/ui/boot_splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=false
config/icon="res://icon.svg"

[autoload]

Weather="*res://scripts/autoload/weather.gd"
NightClock="*res://scripts/autoload/night_clock.gd"
Settings="*res://scripts/autoload/settings.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
Net="*res://scripts/autoload/net.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/aspect="expand"

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/directional_shadow/size=2048
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96

[shader_globals]

wind_strength={
"type": "float",
"value": 0.3
}
wind_dir={
"type": "vec2",
"value": Vector2(1, 0.25)
}
rain_amount={
"type": "float",
"value": 0.3
}
wetness={
"type": "float",
"value": 1.0
}
lightning={
"type": "float",
"value": 0.0
}
